# Copy to .env. Never commit the populated file.
# Empty admin keys are valid: those ingest jobs skip, record a reason, and write
# zero events. Missing keys never fake a $0 total. Local Codex / Claude /
# Traycer / OpenCode ingest does not need keys. Do not use live
# provider calls to prove setup.

# Optional provider-admin credentials (OpenAI usage/cost, Anthropic usage/cost).
ANTHROPIC_ADMIN_KEY=
OPENAI_ADMIN_KEY=
OPENROUTER_MANAGEMENT_KEY=

# Path overrides. Leave these unset unless you need a non-default location.
#   Installed: %LOCALAPPDATA%\BURNRATE\spend.db and %LOCALAPPDATA%\BURNRATE\logs
#   Developer: BURNRATE_DEV=1 uses repo-relative data\spend\spend.db and logs\
#   SPEND_DATABASE_PATH always wins when set.
# SPEND_DATABASE_PATH=
# SPEND_PRICING_PATH=
# BURNRATE_DEV=1
# Claude OAuth credential-file refresh. Off unless this is exactly 1.
# BURNRATE_CLAUDE_OAUTH_REFRESH=
# The HUD is the product. Set to 1 to also serve the full dashboard at /.
# BURNRATE_ENABLE_DASHBOARD=

# Display timezone for spend windows and navbar midnight.
SPEND_TIMEZONE=UTC

# Aggregation thresholds (not credentials).
CACHE_HIT_THRESHOLD=0.75
OVER_ROUTING_TOKEN_CEILING=40000
## Optional existing proxy access for browser writes (does not enable a listener).
BURNRATE_ALLOWED_HOSTS=
BURNRATE_ALLOWED_ORIGINS=
