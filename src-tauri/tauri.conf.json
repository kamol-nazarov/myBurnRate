{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BURNRATE",
  "version": "0.5.1",
  "identifier": "dev.burnrate.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:17331",
    "frontendDist": "../spend_web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BURNRATE · AI Cost Intelligence",
        "url": "starting.html",
        "width": 1340,
        "height": 860,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "hud",
        "title": "BURNRATE · Sidecar HUD",
        "url": "starting.html",
        "width": 380,
        "height": 580,
        "minWidth": 260,
        "minHeight": 160,
        "x": 24,
        "y": 72,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "maximizable": false,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "BURNRATE contributors",
    "homepage": "https://github.com/kamol-nazarov/myBurnRate",
    "copyright": "Apache-2.0",
    "license": "Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI coding-agent usage, plan meters and cost HUD",
    "longDescription": "BURNRATE reads your AI coding tools' local files and shows token usage, plan meters, run-out forecasts and API-equivalent cost in an always-on-top HUD. Nothing leaves your computer unless you connect a hub you run yourself.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/burnrate-service/": "burnrate-service/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDQUNGNEMxNUMxRkNENkQKUldSdHpSOWN3ZlNzWE9yblR0Q1BIZUFTY3VhbWFFeHB2OWVkOVZhUjF5dVNaQm1CWHZTM0I3WkMK",
      "endpoints": [
        "https://github.com/kamol-nazarov/myBurnRate/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
