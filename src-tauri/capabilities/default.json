{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for BURNRATE main dashboard and Always-on-Top Sidecar HUD windows",
  "windows": ["main", "hud"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://127.0.0.1:*/*",
      "http://localhost:*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "allow-toggle-hud",
    "allow-show-hud",
    "allow-hide-hud",
    "allow-get-hud-pin",
    "allow-set-hud-pin",
    "allow-toggle-hud-pin",
    "allow-set-hud-size",
    "allow-start-hud-drag",
    "allow-start-main-drag",
    "allow-show-dashboard",
    "allow-minimize-main",
    "allow-toggle-maximize-main",
    "allow-hide-main",
    "allow-open-setup-wizard",
    "allow-pending-update",
    "allow-install-update"
  ]
}
