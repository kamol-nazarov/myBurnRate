# Copy to deploy/cloud/.env and fill in real values (chmod 600 .env).
BURNRATE_CLOUD_DOMAIN=api.myburnrate.io

# Transactional email via Resend (https://resend.com)
BURNRATE_RESEND_API_KEY=re_replace_with_real_key
BURNRATE_EMAIL_FROM=myBurnRate <no-reply@myburnrate.io>

# Optional: override host bind if sharing ports 80/443 behind an existing host reverse proxy
# BURNRATE_CLOUD_HTTP_BIND=127.0.0.1:8080
# BURNRATE_CLOUD_HTTPS_BIND=127.0.0.1:8443

# Optional: continuous auth.db backups via Litestream (--profile backups)
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
